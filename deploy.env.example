# Copy to `.env` next to docker-compose.yml, then `docker compose up -d`.
#
# The host must be on the building's network or its VPN — the appliances use
# private addresses and are not reachable from a public cloud VM.

# --- required for any non-BSRL site ---------------------------------------

# Any one appliance in the group; the rest are discovered from it.
RW_ROSTER_HOST=https://bsrl-203.arizona.edu/

# IANA zone the appliances are physically in. The appliances report wall-clock
# times with no offset, so this is the only way to interpret them.
RW_TIMEZONE=America/Phoenix

# Label shown in the UI.
RW_SITE_NAME=BSRL

# --- how users reach it ---------------------------------------------------

# Where the browser loads the web UI from. Must match RW_ALLOWED_ORIGINS or
# the browser will block the relay's responses.
RW_WEB_PORT=8080
RW_RELAY_PORT=8787
RW_ALLOWED_ORIGINS=http://localhost:8080

# The relay URL as the *browser* sees it. On a shared deployment this is a
# real hostname, not localhost.
RW_PUBLIC_RELAY_URL=http://localhost:8787

# --- model ----------------------------------------------------------------

# Any Ollama-pullable model with tool-calling support. qwen3:4b runs on a
# machine without a GPU; qwen3:8b is better if there is headroom.
RW_LLM_MODEL=qwen3:4b
