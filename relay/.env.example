# ---------------------------------------------------------------------------
# RoomWizard relay configuration
# ---------------------------------------------------------------------------
#
# Copy to `.env` and edit. Every value has a default describing the BSRL
# building at the University of Arizona, which is the only installation this
# has been tested against.
#
# To point at a DIFFERENT RoomWizard installation, you need two things:
#
#   1. RW_ROSTER_HOST  — any one appliance hostname in the group
#   2. RW_TIMEZONE     — the IANA zone the appliances are physically in
#
# Everything else is discovered from the roster at runtime: the room list,
# capacities, locations, facilities, and the bookable window.
#
# Legacy BSRL_* names are still read as a fallback, so older deployments keep
# working. RW_* wins when both are set.
# ---------------------------------------------------------------------------


# --- Site -----------------------------------------------------------------

# Label shown in the UI and logs.
RW_SITE_NAME=BSRL

# IANA timezone of the appliances. REQUIRED for any non-Arizona deployment:
# the appliances report wall-clock times with no offset, so this is the only
# way to interpret them. Arizona never observes DST; most places do, and the
# relay handles the transitions as long as this is a real IANA name.
#   e.g. America/New_York, Europe/London, Asia/Kolkata, UTC
RW_TIMEZONE=America/Phoenix

# Any appliance in the group. Each RoomWizard aggregates all the others as
# "buddies", so one host yields the whole fleet. A bare hostname is fine;
# https:// and a trailing slash are added if missing.
RW_ROSTER_HOST=https://bsrl-203.arizona.edu/

# Hostname suffix the lowered-TLS agent may be used for.
# The appliances only speak TLS 1.2 with no ECDHE, so the relay has to lower
# OpenSSL's security level to reach them — and must NOT do that for anything
# else. Defaults to the roster host's parent domain (so `.arizona.edu` here).
# Set it explicitly if your appliances span domains.
# RW_HOST_SUFFIX=.arizona.edu

# Explicit room list, used only as a fallback if the roster call fails.
# Normally leave this unset: the roster carries capacity and facilities too.
# RW_ROOM_HOSTS=https://room-a.example.edu/,https://room-b.example.edu/


# --- Server ---------------------------------------------------------------

PORT=8787

# Browser origins allowed to call this relay (comma-separated).
# Add your GitHub Pages origin once the front-end is deployed.
RW_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Bookable window (fallbacks) -----------------------------------------

# The roster reports the real window (timelineStart / timelineEnd) and that
# wins. These apply only if it returns something unusable.
# RW_DAY_START_HOUR=7
# RW_DAY_END_HOUR=19
# RW_SLOT_MINUTES=15


# --- Load and limits ------------------------------------------------------
#
# These appliances are 2013-era embedded hardware running Jetty 8. Be gentle:
# cache generously and keep concurrency at roughly one request per room.

# How long to cache the room roster. It changes approximately never.
# RW_CACHE_ROOMS_MS=3600000

# How long to cache bookings. Keep this short — someone else may be booking
# right now — but not zero, or every page load re-hits the whole fleet.
# RW_CACHE_BOOKINGS_MS=30000

# Per-request timeout when talking to an appliance.
# RW_TIMEOUT_MS=15000

# Max concurrent appliance requests. One per room is the natural ceiling.
# RW_MAX_CONCURRENCY=9

# Largest availability range a client may ask for, in days. Each day costs
# one request per room.
# RW_MAX_RANGE_DAYS=31
